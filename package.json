{
  "name": "chessmovesjs",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.cjs"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vp test",
    "perft": "vp test test/perft.ts",
    "bench": "vp pack --logLevel error && node scripts/bench.ts",
    "bench:search": "vp pack --logLevel error && node scripts/search-bench.ts",
    "lint": "vp lint",
    "typecheck": "vp check --no-lint",
    "check": "vp check"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24",
    "vite-plus": "1.2.0"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4"
  }
